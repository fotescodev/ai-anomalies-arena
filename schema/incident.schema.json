{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fotescodev/ai-anomalies-arena/schema/incident.schema.json",
  "title": "AI Anomalies Arena incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "model",
    "lab",
    "category",
    "severity",
    "status",
    "date",
    "place",
    "lat",
    "lng",
    "blurb",
    "sources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 12, "maxLength": 180 },
    "model": { "type": "string" },
    "lab": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "agent escape",
        "unauthorized access",
        "hallucination",
        "scheming",
        "production wipe",
        "jailbreak",
        "loss of control",
        "other"
      ]
    },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "status": { "type": "string", "enum": ["documented", "hashed", "alleged", "rejected"] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "place": { "type": "string" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "score": { "type": "integer" },
    "blurb": { "type": "string", "minLength": 40 },
    "excerpt": { "type": "string" },
    "proofType": { "type": "string" },
    "correction": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer" },
          "mime": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["who", "text"],
        "properties": {
          "who": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
